# Copy to config.env and edit. Every line is optional: unset values use the
# defaults shown here. config.env is ignored by git.

# The account the agent runs as. Gets no sudo and no privileged groups.
AGENT_USER=mrdata

# --- Colibri (model server) --------------------------------------------------
# Where you cloned and built https://github.com/JustVugg/colibri
COLIBRI_DIR=/opt/colibri
# The model to serve, as downloaded by `coli setup` (copied into /var/lib/colibri)
COLIBRI_MODEL_SRC=
# System user and unit name for the service
COLIBRI_USER=colibri
COLIBRI_UNIT=colibri
COLIBRI_HOST=127.0.0.1
COLIBRI_PORT=8000
COLIBRI_GPU=auto
COLIBRI_EXTRA_ARGS="--auto-tier"
# yes: clients need the key in /etc/colibri/colibri.env (recommended)
COLIBRI_REQUIRE_KEY=yes
COLIBRI_KEY_FILE=/etc/colibri/colibri.env
# The model OpenClaw uses. Empty: the first one Colibri lists.
COLIBRI_MODEL_ID=

# --- OpenClaw (agent) --------------------------------------------------------
# Pinned to the version this was tested with. Use "latest" at your own risk.
OPENCLAW_VERSION=2026.11.6
OPENCLAW_PORT=18789
OPENCLAW_UNIT=openclaw-gateway
# yes: install-openclaw.sh sets tools.profile coding, browser.enabled false and
# tools.elevated.enabled false, and fills an empty plugins.allow with
# OPENCLAW_PLUGINS. no: leave those settings to you.
OPENCLAW_HARDEN=yes
# Plugins allowed to load (memory-core, the memory plugin, loads anyway).
# install-searxng.sh adds searxng. See them with: openclaw plugins list --enabled
OPENCLAW_PLUGINS="document-extract web-readability ollama"
# yes: install the ponytail coding skills (https://github.com/DietrichGebert/ponytail)
# into the agent's ~/.openclaw/skills. Plain Markdown instructions, no code.
# Pinned to a reviewed commit; change it only after reading the new skills.
PONYTAIL=no
PONYTAIL_REF=96608e078b2d5ea607c5c3b8b5a54d1c1fba6846

# --- Sandbox for the agent's tools (install-sandbox.sh) ----------------------
# none: commands in the sandbox have no network. bridge: they can reach the internet.
SANDBOX_NETWORK=none
# What the sandbox sees of the agent's workspace: none, ro or rw
SANDBOX_WORKSPACE=rw
# Extra folders, space-separated /host/path:/path/in/sandbox:ro (or :rw).
# The agent user needs access to them itself (README: Share a folder).
SANDBOX_BINDS=""
# Tools that run in the gateway, outside the sandbox, but that the main agent
# may use from it. OpenClaw's sandbox allows none of them by default. The
# researcher agent always gets web_search and web_fetch (README: Two agents).
# Add web_fetch here to let main read pages itself; set "" for none.
SANDBOX_GATEWAY_TOOLS="web_search memory_search memory_get"
# Where the researcher agent saves its results (read-only for main).
# Empty: research/ in the agent user's home. Not inside ~/.openclaw.
RESEARCH_DIR=

# --- SearXNG web search (install-searxng.sh) ---------------------------------
SEARXNG_UNIT=searxng
SEARXNG_PORT=8888
# Pinned by digest. Update on purpose: pick a new digest, run install-searxng.sh.
SEARXNG_IMAGE=docker.io/searxng/searxng@sha256:5ed0323b5f5f8701264ef65e239a2bd83cb57098f2b971fa30bf79c06eeae271
SEARXNG_CONFIG_DIR=/etc/searxng-agent

# --- Ollama (optional: memory search embeddings, checked by verify.sh) ------
OLLAMA_UNIT=ollama
OLLAMA_PORT=11434
# Embedding model for the agent's memory search (install-openclaw.sh sets it
# if Ollama has it and no other provider is chosen)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groups the agent user is removed from, because they give root or near-root
# access (wheel/sudo/docker/disk), let it read system logs (adm/systemd-journal)
# or let it change model files (ollama).
PRIVILEGED_GROUPS="wheel sudo admin docker podman libvirt lxd incus disk adm systemd-journal ollama"
