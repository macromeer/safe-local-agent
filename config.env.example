# Copy to config.env and edit. Every line is optional: unset values use the
# defaults shown here. config.env is ignored by git.

# The account the agent runs as. Gets no sudo and no privileged groups.
AGENT_USER=mrdata

# --- Colibri (model server) --------------------------------------------------
# Where you cloned and built https://github.com/JustVugg/colibri
COLIBRI_DIR=/opt/colibri
# The model to serve, as downloaded by `coli setup` (copied into /var/lib/colibri)
COLIBRI_MODEL_SRC=
# System user and unit name for the service
COLIBRI_USER=colibri
COLIBRI_UNIT=colibri
COLIBRI_HOST=127.0.0.1
COLIBRI_PORT=8000
COLIBRI_GPU=auto
COLIBRI_EXTRA_ARGS="--auto-tier"
# yes: clients need the key in /etc/colibri/colibri.env (recommended)
COLIBRI_REQUIRE_KEY=yes
COLIBRI_KEY_FILE=/etc/colibri/colibri.env

# --- OpenClaw (agent) --------------------------------------------------------
# Pinned to the version this was tested with. Use "latest" at your own risk.
OPENCLAW_VERSION=2026.11.6
OPENCLAW_PORT=18789
OPENCLAW_UNIT=openclaw-gateway

# --- Ollama (optional, only checked by verify.sh) ----------------------------
OLLAMA_UNIT=ollama
OLLAMA_PORT=11434

# Groups the agent user is removed from, because they give root or near-root
# access (wheel/sudo/docker/disk), let it read system logs (adm/systemd-journal)
# or let it change model files (ollama).
PRIVILEGED_GROUPS="wheel sudo admin docker podman libvirt lxd incus disk adm systemd-journal ollama"
