# Rendered by scripts/install-colibri-service.sh. Edit the template, not the
# installed copy in /etc/systemd/system.
[Unit]
Description=Colibri OpenAI-compatible model server (safe-local-agent)
After=network.target

[Service]
Type=simple
User=@COLIBRI_USER@
Group=@COLIBRI_USER@
WorkingDirectory=@COLIBRI_DIR@
Environment=HOME=@STATE_DIR@
Environment=XDG_CACHE_HOME=@STATE_DIR@/.cache
Environment=PYTHONUNBUFFERED=1
# COLI_API_KEY=...: when set, clients must send it as a Bearer token
EnvironmentFile=-@KEY_FILE@
ExecStart=@PYTHON@ @COLIBRI_DIR@/c/coli serve --model @MODEL_DIR@ --host @HOST@ --port @PORT@ --gpu @GPU@ @EXTRA_ARGS@
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

# @STATE_DIR@, owned by @COLIBRI_USER@ (holds the model copy; Colibri writes usage stats there)
StateDirectory=@STATE_NAME@
StateDirectoryMode=0750

# Hardening. PrivateDevices and MemoryDenyWriteExecute are left out because
# they break CUDA. If the GPU is not found, try commenting out
# RestrictNamespaces and ProtectKernelTunables first.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Localhost only: the model server cannot reach the internet or the LAN
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
